# GEMINI_API_KEY: Required for Devshree AI Hardware Shopping Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DEVSHREE ADMIN CREDENTIALS (Securely configured by store owner during deployment)
ADMIN_EMAIL="admin@devshreehardware.com"
ADMIN_PASSWORD="CHANGE_ME_SECURE_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="devshree_jwt_secret_key_prod_hardware_2026"

# PAYMENT GATEWAY (Razorpay India production / test keys)
RAZORPAY_KEY_ID="rzp_test_hardware_sample_key"
RAZORPAY_KEY_SECRET="rzp_secret_hardware_sample_secret"

# STORE CONFIGURATION
PORT=3000

